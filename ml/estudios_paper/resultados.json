      },
      "semana_anio": {
        "origen": "fecha de embarque (usuario)",
        "construccion": "derivada: semana ISO"
      },
      "mes_sin": {
        "origen": "fecha de embarque (usuario)",
        "construccion": "derivada: sin(2*pi*mes/12)"
      },
      "mes_cos": {
        "origen": "fecha de embarque (usuario)",
        "construccion": "derivada: cos(2*pi*mes/12)"
      },
      "mercado_lag1": {
        "origen": "serie de mercado (sistema)",
        "construccion": "media del mes m-1"
      },
      "mercado_lag2": {
        "origen": "serie de mercado (sistema)",
        "construccion": "media del mes m-2"
      },
      "mercado_lag3": {
        "origen": "serie de mercado (sistema)",
        "construccion": "media del mes m-3"
      },
      "mercado_ma3": {
        "origen": "serie de mercado (sistema)",
        "construccion": "media movil de m-1..m-3"
      },
      "puerto_freq": {
        "origen": "puerto de embarque (usuario)",
        "construccion": "encoder de frecuencia ajustado con train"
      },
      "importador_freq": {
        "origen": "importador (usuario, opcional)",
        "construccion": "encoder de frecuencia; si se omite, mediana de train"
      },
      "densidad_carga": {
        "origen": "peso neto y unidades (usuario; unidades opcional)",
        "construccion": "peso/unidades; si falta, mediana de train"
      },
      "ratio_bruto_neto": {
        "origen": "no capturado en el formulario",
        "construccion": "SIEMPRE la mediana de train (constante en produccion)"
      },
      "ruta_directa": {
        "origen": "puerto de embarque (usuario)",
        "construccion": "lookup deterministico puerto -> regimen; nunca se pide"
      }
    },
    "constantes_en_produccion": {
      "ratio_bruto_neto": 1.003915,
      "densidad_carga_default": 9.534,
      "importador_freq_default": 0.00082682,
      "puerto_freq_default": 0.00081649
    },
    "nota": "El formulario NO captura peso bruto ni tipo de contenedor. `ratio_bruto_neto` es por tanto una constante en produccion (la mediana de train) y `densidad_carga` cae a su mediana si el usuario omite las unidades. Ambas aportan en conjunto ~1.1% del gain, de modo que la degradacion es marginal, pero debe declararse: son features del entrenamiento que produccion no puede reconstruir con fidelidad."
